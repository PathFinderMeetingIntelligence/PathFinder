.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ── Windows ────────────────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Node / Tooling (if build tooling is added later) ──────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock
.pnpm-store/

# ── Build output ───────────────────────────────────────────────────────────────
dist/
build/
out/
.cache/

# ── Environment & secrets ──────────────────────────────────────────────────────
# NEVER commit API keys, credentials, or PHI-adjacent config
.env
.env.*
.env.local
.env.*.local
!.env.example
*.pem
*.key
*.cert
secrets/

# ── Logs ───────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Editor: VS Code ────────────────────────────────────────────────────────────
# Keep shared extension recommendations; ignore personal/machine settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# ── Editor: JetBrains / IntelliJ / WebStorm ───────────────────────────────────
.idea/
*.iml
*.iws
*.ipr

# ── Editor: Visual Studio ──────────────────────────────────────────────────────
*.suo
*.ntvs*
*.njsproj
*.sln

# ── Editor: Vim / Emacs ────────────────────────────────────────────────────────
*.swp
*.swo
*.sw?
*~
\#*\#
.\#*

# ── Testing & coverage ─────────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ── HTML exports (intermediate / versioned demo files) ─────────────────────────
# Scratch exports produced during iterative development — not part of the repo
*_fix.html
*_v[0-9]*.html
PathFinder_*.html
pathfinder-demo.html.bak

# ── Misc ───────────────────────────────────────────────────────────────────────
*.bak
*.tmp
*.orig
